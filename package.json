    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.58.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "1.1.1",
    "markdownlint-cli2": "0.18.1",
    "mermaid": "12.1.0",
    "happy-dom": "20.14.6",
    "@types/bun": "1.3.11"
