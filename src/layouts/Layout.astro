---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import Mark from "../components/Mark.astro";
import Header from "../components/Header.astro";
import Icon from "../components/Icon";
import Search from "../components/Search.astro";
import { navigation, site, resources } from "../content/site";
const {
  title = "Connecting science. Creating value.",
  description = "Strategic business development advisory for biotech and biopharma. JEA BizDev Consulting, LLC® helps build high-value partnerships across North America, Europe, and Asia.",
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#172b50" />
    <title>{title} | JEA BizDev Consulting</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/brand/mark.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | JEA BizDev`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL("/brand/social.png", Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta
      property="og:image:alt"
      content="JEA BizDev Consulting — Connecting science. Creating value. Biotech and biopharma advisory across continents."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:image"
      content={new URL("/brand/social.png", Astro.site)}
    />
    <meta
      name="twitter:image:alt"
      content="JEA BizDev Consulting — Connecting science. Creating value."
    />
    {noindex && <meta name="robots" content="noindex" />}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        name: site.name,
        url: Astro.site,
        email: site.email,
        sameAs: [site.linkedin],
        description,
        areaServed: ["North America", "Europe", "Asia"],
      })}
    />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <Search />
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="wrap footer-top">
        <div class="footer-identity">
          <Mark light legalName />
          <p>
            Connecting science.
            <br />
            Creating lasting value.
          </p>
          <span class="micro">NORTH AMERICA · EUROPE · ASIA</span>
        </div>
        <div>
          <h2 class="eyebrow">EXPLORE</h2>
          {navigation.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
          <a href="/transactions">Track record</a>
          {resources.map((resource) => (
            <a href={resource.href} target="_blank" rel="noreferrer">
              {resource.label}
            </a>
          ))}
        </div>
        <div>
          <h2 class="eyebrow">LET’S CONNECT</h2>
          <a href={`mailto:${site.email}`}>
            <Icon name="mail" size={15} /> {site.email}
          </a>
          <a href={site.linkedin} target="_blank" rel="noreferrer">
            <Icon name="linkedin" size={15} /> LinkedIn
          </a>
          <a href="/contact">Discuss an opportunity</a>
          <p class="micro">
            John Adamou, MS, MBA
            <br />
            President & Managing Director
          </p>
        </div>
        <div class="footer-invitation">
          <h2>
            Your next chapter.
            <br />
            <em>Our shared ambition.</em>
          </h2>
          <a class="button outline-light" href="/contact">
            Let’s build it together
          </a>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>© {new Date().getFullYear()} JEA BizDev Consulting, LLC.</span>
        <div>
          <a href="/privacy">Privacy</a>
          <a href="/disclaimer">Disclaimer</a>
          <a href="/brand">Brand resources</a>
          <button data-top>
            Back to top <Icon name="up" size={14} />
          </button>
        </div>
      </div>
    </footer>
    <script src="../client/chrome.ts" />
    <script src="../client/transitions.ts" />
    <script src="../client/scroll-top.ts" />
    {import.meta.env.PROD && <Analytics />}
  </body>
</html>
