---
import Icon from "../components/Icon";
import YearFilter from "../components/YearFilter";
import Layout from "../layouts/Layout.astro";
import Intro from "../components/Intro.astro";
import DealChart from "../components/DealChart.astro";
import Stats from "../components/Stats.astro";
import Closing from "../components/Closing.astro";
import TransactionCard from "../components/TransactionCard.astro";
import { transactions, summaries } from "../content/site";
---

<Layout title="Selected partnerships & transaction experience">
  <Intro
    eyebrow="OUR TRACK RECORD"
    title="Relationships that create value."
    description="Selected partnerships supported by JEA as lead business development and transaction advisor, alongside examples of cross-border transaction experience."
  />
  <section class="wrap section">
    <Stats />
    <DealChart />
    <div class="section-heading" style="margin-top:65px">
      <div>
        <p class="eyebrow">CLIENT SHOWCASE</p>
        <h2>
          Partnerships in <em>practice.</em>
        </h2>
      </div>
    </div>
    <div data-directory>
      <div class="filters">
        <label>
          Search partnerships
          <input
            type="search"
            data-directory-query
            placeholder="Search company or agreement…"
          />
        </label>
        <YearFilter client:load />
      </div>
      <p class="library-status" data-directory-count role="status">
        5 partnerships
      </p>
      <div class="transaction-grid">
        {transactions.map((deal) => (
          <div
            class="transaction-item"
            data-directory-item
            data-category={deal.year}
            data-search={`${deal.title} ${deal.description} ${deal.type}`}
          >
            <TransactionCard deal={deal} />
          </div>
        ))}
      </div>
      <div class="empty" data-directory-empty hidden>
        <h3>No matching partnerships.</h3>
        <button class="button" data-directory-reset>
          Reset filters
        </button>
      </div>
    </div>
  </section>
  <section class="tool-spotlight" id="deal-summaries">
    <div class="wrap section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">TRANSACTION PRECEDENTS</p>
          <h2>
            The detail behind <em>the deal.</em>
          </h2>
        </div>
        <p>
          Explore eight deal sheet summaries covering partnerships and
          cross-border transactions.
        </p>
      </div>
      <ul class="deal-grid">
        {summaries.map(([name, year, file]) => (
          <li>
            <a
              href={`/deal-summaries/${encodeURIComponent(file)}`}
              target="_blank"
              rel="noreferrer"
            >
              <span class="deal-meta">
                <span>{year}</span>
                <Icon name="file" size={22} />
              </span>
              <h3>{name}</h3>
              <span class="micro">
                Read deal summary · PDF
                <span class="sr-only"> (opens in a new tab)</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="micro deal-note">
        Historical summaries are provided for reference. Headline values may
        include contingent payments.
      </p>
    </div>
  </section>
  <Closing />
</Layout>
<script>
  import "../client/directory";
</script>
<style>
  .transaction-item {
    display: flex;
  }
  .transaction-item .transaction-card {
    width: 100%;
  }
  .deal-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .deal-grid a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 24px;
    background: white;
    border: 1px solid var(--line);
    border-radius: 6px;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .deal-grid a:hover {
    border-color: var(--accent);
    box-shadow: 0 6px 20px #172b5008;
  }
  .deal-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--accent);
    font-size: 12px;
    margin-bottom: 26px;
  }
  .deal-grid h3 {
    font: 550 17px/1.4 var(--sans);
    margin-bottom: 20px;
  }
  .deal-grid .micro {
    margin-top: auto;
  }
  .deal-note {
    margin: 24px 0 0;
  }
  @media (max-width: 1100px) {
    .deal-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .deal-grid {
      grid-template-columns: 1fr;
    }
    .deal-meta {
      margin-bottom: 16px;
    }
  }
</style>
