---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" noindex>
  <section class="wrap page-intro" style="padding-bottom:100px">
    <p class="eyebrow">404 · A DIFFERENT DIRECTION</p>
    <h1>
      Let’s find your
      <br />
      <em>way forward.</em>
    </h1>
    <p class="lead">
      This page is no longer here, or the address may have changed. Explore our
      services, browse partnering opportunities, or search the site.
    </p>
    <div class="actions">
      <a class="button" href="/">
        Back to home
      </a>
      <button class="button secondary" data-search-open>
        Search the site
      </button>
      <a class="text-link" href="/assets">
        Explore opportunities
      </a>
    </div>
  </section>
</Layout>
