---
import Layout from "../layouts/Layout.astro";
import Intro from "../components/Intro.astro";
---

<Layout title="Privacy">
  <Intro
    eyebrow="YOUR INFORMATION"
    title="Privacy, with clarity."
    description="Access JEA’s privacy policy and understand how the website’s inquiry form handles your information."
  />
  <section class="wrap section">
    <div class="prose">
      <h2>JEA’s privacy policy</h2>
      <p>
        The existing JEA BizDev Consulting privacy policy is available in its
        original format.
      </p>
      <a
        class="button"
        href="/Privacy%20Policy.pdf"
        target="_blank"
        rel="noreferrer"
      >
        Read the privacy policy (PDF)
      </a>
      <h2>When you get in touch</h2>
      <p>
        The inquiry form asks for your contact details, company, and a
        non-confidential description of your priorities. Entering your
        information keeps those details in the current browser tab. Choosing
        “Send inquiry” submits them through the website’s Formcarry delivery
        service so JEA can respond.
      </p>
      <h2>Website analytics</h2>
      <p>
        The production website retains Vercel Web Analytics for aggregate
        website usage. Inquiry text is not added to analytics events.
      </p>
      <h2>Questions</h2>
      <p>
        For questions about your information, contact{" "}
        <a href="mailto:jeabizdev@gmail.com">jeabizdev@gmail.com</a>.
      </p>
    </div>
  </section>
</Layout>
