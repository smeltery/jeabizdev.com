---
import Layout from "../../layouts/Layout.astro";
import Calculator from "../../tools/Calculator";
import { tools } from "../../tools/catalog";
export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}
const { tool } = Astro.props;
const related = tools
  .filter((item) => item.category === tool.category && item.slug !== tool.slug)
  .slice(0, 3);
---

<Layout title={tool.title} description={tool.description}>
  <section class="wrap page-intro">
    <div class="breadcrumbs">
      <a href="/tools">BD toolkit</a> / {tool.category}
    </div>
    <p class="eyebrow">{tool.category}</p>
    <h1>{tool.title}</h1>
    <p class="lead">{tool.description}</p>
  </section>
  <section class="wrap section">
    <Calculator tool={tool} client:load />
    <noscript>
      <p class="note">
        Enable JavaScript to use this calculator. The formula and example below
        are available without it.
      </p>
    </noscript>
    <div class="tool-guide">
      <div>
        <p class="eyebrow">HOW IT WORKS</p>
        <h2>The calculation.</h2>
        <p>{tool.formula}</p>
        <h3>A worked example</h3>
        <p>{tool.example}</p>
      </div>
      <div>
        <p class="eyebrow">KEEP IN MIND</p>
        <h2>Context matters.</h2>
        <p>{tool.assumptions}</p>
        <p>
          Use this as a starting point for a conversation, not a valuation or
          recommendation. The numbers do not account for every commercial,
          scientific, or contractual consideration.
        </p>
        <a class="text-link" href="/contact">
          Talk through your priorities
        </a>
      </div>
    </div>
  </section>
  <section class="tool-spotlight">
    <div class="wrap section">
      <div class="section-heading">
        <h2>
          Keep <em>exploring.</em>
        </h2>
        <a class="text-link" href="/tools">
          All sixteen tools
        </a>
      </div>
      <div class="library-grid">
        {related.map((item) => (
          <a class="library-card" href={`/tools/${item.slug}`}>
            <span class="badge">{item.category}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <span class="text-link">Open tool</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
