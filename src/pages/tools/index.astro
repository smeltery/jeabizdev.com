---
import ToolWorkspace from "../../tools/ToolWorkspace";
import Layout from "../../layouts/Layout.astro";
import Intro from "../../components/Intro.astro";
import Closing from "../../components/Closing.astro";
import { tools } from "../../tools/catalog";
---

<Layout title="Business development toolkit">
  <Intro
    eyebrow="THE BD TOOLKIT"
    title="A little clarity. Before the next step."
    description="Explore deal economics, capital needs, and partnering scenarios with sixteen practical tools. No account. No saved financial data. Just a clearer starting point."
  />
  <section class="wrap section" data-directory data-noun="tools">
    <div class="section-tail" style="margin:0 0 25px">
      <p class="micro">Find a guide or use a calculator right here.</p>
      <a class="text-link" href="#workspace">
        Use the all-in-one workspace
      </a>
    </div>
    <div class="filters">
      <label>
        Find a tool
        <input
          type="search"
          data-directory-query
          placeholder="Search royalties, runway, deal value…"
        />
      </label>
    </div>
    <div class="filter-chips" role="group" aria-label="Tool categories">
      {["", ...new Set(tools.map((tool) => tool.category))].map((category) => (
        <button data-category-filter={category} aria-pressed={!category}>
          {category || "All tools"}
        </button>
      ))}
    </div>
    <p class="library-status" data-directory-count role="status">
      16 tools · Free to use
    </p>
    <div class="library-grid">
      {tools.map((tool, index) => (
        <a
          class="library-card"
          href={`/tools/${tool.slug}`}
          data-directory-item
          data-category={tool.category}
          data-search={`${tool.title} ${tool.description} ${tool.category}`}
        >
          <span class="badge">{tool.category}</span>
          <h2>{tool.title}</h2>
          <p>{tool.description}</p>
          <div class="card-bottom">
            <span>{String(index + 1).padStart(2, "0")} / JEA TOOLKIT</span>
            <span>Open tool</span>
          </div>
        </a>
      ))}
    </div>
    <div class="empty" data-directory-empty hidden>
      <h3>No tools match that search.</h3>
      <p>Try a broader term or browse the full toolkit.</p>
      <button class="button" data-directory-reset>
        Show all tools
      </button>
    </div>
    <p class="note">
      These tools illustrate arithmetic using your assumptions. They are not
      asset valuations, clinical forecasts, financial advice, or JEA fee quotes.
      Each tool explains its formula and limitations.
    </p>
  </section>
  <section class="tool-spotlight" id="workspace">
    <div class="wrap section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">ONE PLACE TO EXPLORE</p>
          <h2>
            Your BD <em>workspace.</em>
          </h2>
        </div>
      </div>
      <ToolWorkspace client:visible />
    </div>
  </section>
  <Closing />
</Layout>
<script>
  import "../../client/directory";
</script>
