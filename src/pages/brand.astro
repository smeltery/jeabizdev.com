---
import Layout from "../layouts/Layout.astro";
import Intro from "../components/Intro.astro";
---

<Layout title="Brand resources">
  <Intro
    eyebrow="THE JEA BizDev Consulting, LLC® IDENTITY"
    title="The JEA BizDev Consulting, LLC® identity."
    description="A visual identity built around scientific ambition, international perspective, and the relationships that create lasting value."
  />
  <section class="wrap section">
    <div class="split">
      <div>
        <p class="eyebrow">THE MARK</p>
        <h2>
          Science at
          <br />
          <em>the center.</em>
        </h2>
        <p class="lead">
          The DNA mark and JEA BizDev Consulting name come directly from the
          existing JEA BizDev Consulting, LLC® website. They keep the business
          grounded in the science behind every partnership.
        </p>
      </div>
      <div>
        <div class="brand-download">
          <img
            src="/brand/mark.svg"
            alt="JEA BizDev Consulting, LLC® DNA logo"
            width="80"
            height="80"
          />
          <div>
            <h3>JEA BizDev Consulting, LLC® DNA mark</h3>
            <a class="text-link" href="/brand/mark.svg" download>
              Download SVG ↓
            </a>
          </div>
        </div>
        <a class="text-link" href="/brand/wordmark.svg" download>
          Download full wordmark ↓
        </a>
      </div>
    </div>
    <section class="favicon-section" aria-labelledby="favicon-title">
      <div>
        <p class="eyebrow">IN THE BROWSER</p>
        <h2 id="favicon-title">A small, familiar signature.</h2>
        <p>The DNA mark stays recognizable in browser tabs and bookmarks.</p>
        <a class="text-link" href="/brand/mark.svg" download="jea-favicon.svg">
          Download favicon SVG
        </a>
      </div>
      <div class="favicon-preview">
        <div class="browser-tab">
          <img
            src="/brand/mark.svg"
            width="16"
            height="16"
            alt="JEA BizDev Consulting, LLC® favicon"
          />
          <span>JEA BizDev Consulting</span>
          <span aria-hidden="true">×</span>
        </div>
        <div class="favicon-sizes">
          {[16, 32, 48].map((size) => (
            <div>
              <img src="/brand/mark.svg" width={size} height={size} alt="" />
              <span>{size} px</span>
            </div>
          ))}
        </div>
      </div>
    </section>
    <div class="section-heading" style="margin-top:70px">
      <div>
        <p class="eyebrow">COLOR PALETTE</p>
        <h2>
          Grounded. <em>Distinctive.</em>
        </h2>
      </div>
    </div>
    <div class="swatches">
      {[
        ["JEA BizDev Consulting, LLC® blue", "#2563EB"],
        ["White", "#FFFFFF"],
        ["Charcoal", "#1F2937"],
        ["Light blue", "#EFF6FF"],
      ].map(([name, color]) => (
        <div class="swatch">
          <div style={`background:${color}`}></div>
          <strong>{name}</strong>
          <p class="micro">{color}</p>
        </div>
      ))}
    </div>
    <div class="brand-guide">
      <div>
        <h2>Typography</h2>
        <p>
          Georgia lends an editorial voice to headlines. Geist provides clarity
          in navigation, supporting copy, and forms.
        </p>
      </div>
      <div>
        <h2>Using the identity</h2>
        <p>
          Keep the mark’s proportions intact, allow clear space around it, and
          use the provided palette. Contact JEA BizDev Consulting, LLC® for
          questions about use in partnership announcements.
        </p>
        <a class="text-link" href="/contact">
          Contact JEA BizDev Consulting, LLC®
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .favicon-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    margin-top: 80px;
    align-items: center;
  }
  .favicon-section h2 {
    font-size: clamp(30px, 3vw, 44px);
  }
  .favicon-preview {
    background: var(--wash);
    padding: 30px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .browser-tab {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: white;
    border-radius: 10px 10px 0 0;
    font-size: 12px;
  }
  .browser-tab span:last-child {
    margin-left: auto;
  }
  .favicon-sizes {
    display: flex;
    align-items: end;
    justify-content: space-around;
    padding-top: 36px;
  }
  .favicon-sizes div {
    display: grid;
    justify-items: center;
    gap: 12px;
    font-size: 11px;
    color: var(--muted);
  }
  @media (max-width: 800px) {
    .favicon-section {
      grid-template-columns: 1fr;
      gap: 25px;
    }
  }
</style>
