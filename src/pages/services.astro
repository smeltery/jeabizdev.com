---
import Icon from "../components/Icon";
import EditorialImage from "../components/EditorialImage.astro";
import Layout from "../layouts/Layout.astro";
import Intro from "../components/Intro.astro";
import Closing from "../components/Closing.astro";
import { services, engagements } from "../content/site";
---

<Layout title="Expertise across the BD value chain">
  <Intro
    eyebrow="OUR SERVICES"
    title="The right expertise. At every stage."
    description="Strategic advice and hands-on execution for biotech and biopharma companies. A focused engagement or a partner for the full journey."
  />
  <section class="wrap section">
    <div class="service-grid">
      {services.map((service, index) => (
        <article
          class="service-card"
          id={service.title.toLowerCase().replace(/[^a-z]+/g, "-")}
        >
          <span class="card-number">
            0{index + 1}
            <span>{service.tag}</span>
          </span>
          <h2 style="font-size:29px">{service.title}</h2>
          <p>{service.description}</p>
          <p style="margin-top:15px">{service.detail}</p>
        </article>
      ))}
    </div>
    <EditorialImage subject="laboratory" />
    <aside class="deal-callout" aria-labelledby="deal-callout-title">
      <div>
        <p class="eyebrow">THE TRANSACTION LIBRARY</p>
        <h2 id="deal-callout-title">See the detail behind the deals.</h2>
        <p>
          Explore eight transaction summaries covering strategic partnerships
          and cross-border agreements.
        </p>
      </div>
      <a class="button" href="/transactions#deal-summaries">
        <Icon name="file" /> Browse deal summaries
      </a>
    </aside>
  </section>
  <section class="tool-spotlight" id="engagements">
    <div class="wrap section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">FLEXIBLE ENGAGEMENTS</p>
          <h2>
            A working model
            <br />
            that fits <em>your needs.</em>
          </h2>
        </div>
        <p>
          Every engagement begins with a conversation about your priorities,
          scope, and the support that will make the most difference.
        </p>
      </div>
      <div class="engagement-grid">
        {engagements.map(([title, subtitle, description]) => (
          <article>
            <h3>{title}</h3>
            <strong>{subtitle}</strong>
            <p>{description}</p>
            <a
              class="text-link"
              href={`/contact?engagement=${encodeURIComponent(title)}`}
            >
              Discuss this model
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Closing />
</Layout>

<style>
  .deal-callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    margin-top: 32px;
    padding: 30px 32px;
    background: var(--wash);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
  }
  .deal-callout .eyebrow {
    margin-bottom: 10px;
    color: var(--accent);
    font-size: 10px;
  }
  .deal-callout h2 {
    font-size: clamp(26px, 2.5vw, 34px);
    margin-bottom: 12px;
  }
  .deal-callout p:last-child {
    margin: 0;
    color: var(--muted);
    max-width: 60ch;
    font-size: 14px;
  }
  .deal-callout .button {
    flex-shrink: 0;
    gap: 10px;
  }
  @media (max-width: 800px) {
    .deal-callout {
      align-items: start;
      flex-direction: column;
      gap: 22px;
      padding: 24px;
    }
  }
  @media (max-width: 540px) {
    .deal-callout .button {
      width: 100%;
    }
  }
</style>
