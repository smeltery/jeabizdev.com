---
import Icon from "../components/Icon";
import EditorialImage from "../components/EditorialImage.astro";
import Layout from "../layouts/Layout.astro";
import Intro from "../components/Intro.astro";
import Closing from "../components/Closing.astro";
import { services, engagements } from "../content/site";
---

<Layout title="Expertise across the BD value chain">
  <Intro
    eyebrow="OUR SERVICES"
    title="The right expertise. At every stage."
    description="Strategic advice and hands-on execution for biotech and biopharma companies. A focused engagement or a partner for the full journey."
  />
  <section class="wrap section services-overview">
    <div class="service-grid">
      {services.map((service, index) => (
        <article
          class="service-card"
          id={service.title.toLowerCase().replace(/[^a-z]+/g, "-")}
        >
          <span class="card-number">
            0{index + 1}
            <span>{service.tag}</span>
          </span>
          <h2 style="font-size:29px">{service.title}</h2>
          <p>{service.description}</p>
          <p style="margin-top:15px">{service.detail}</p>
        </article>
      ))}
    </div>
    <aside class="deal-callout" aria-labelledby="deal-callout-title">
      <EditorialImage subject="partnership" embedded />
      <div class="deal-callout-content">
        <p class="eyebrow">THE TRANSACTION LIBRARY</p>
        <h2 id="deal-callout-title">See the detail behind the deals.</h2>
        <p class="deal-description">
          Explore eight transaction summaries covering strategic partnerships
          and cross-border agreements.
        </p>
        <a class="button" href="/transactions#deal-summaries">
          <Icon name="file" /> Browse deal summaries
        </a>
      </div>
    </aside>
  </section>
  <section class="highlight-section" id="engagements">
    <div class="wrap section engagement-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">FLEXIBLE ENGAGEMENTS</p>
          <h2>
            Choose the support <em>you need.</em>
          </h2>
        </div>
        <p>
          One-off advice, ongoing support, or a defined project. Agree the scope
          and fee structure directly with John.
        </p>
      </div>
      <div class="engagement-grid">
        {engagements.map(([title, subtitle, description]) => (
          <article>
            <h3>{title}</h3>
            <strong>{subtitle}</strong>
            <p>{description}</p>
            <a
              class="text-link"
              href={`/contact?engagement=${encodeURIComponent(title)}`}
            >
              Discuss {title.toLowerCase()} support
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Closing />
</Layout>

<style>
  .engagement-section {
    padding-block: 48px;
  }
  .engagement-section .section-heading {
    margin-bottom: 28px;
  }
  .engagement-section h2 {
    font-size: clamp(30px, 3.5vw, 46px);
  }
  .services-overview {
    padding-bottom: 40px;
  }
  .deal-callout {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    align-items: center;
    gap: 32px;
    margin-top: 32px;
    padding: 30px 32px;
    background: var(--wash);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
  }
  .deal-callout .eyebrow {
    margin-bottom: 10px;
    color: var(--accent);
    font-size: 10px;
  }
  .deal-callout h2 {
    font-size: clamp(26px, 2.5vw, 34px);
    margin-bottom: 12px;
  }
  .deal-description {
    margin: 0 0 20px;
    color: var(--muted);
    max-width: 60ch;
    font-size: 14px;
  }
  .deal-callout .button {
    gap: 10px;
  }
  @media (max-width: 640px) {
    .deal-callout {
      align-items: start;
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      padding: 24px;
    }
  }
  @media (max-width: 540px) {
    .deal-callout .button {
      width: 100%;
    }
  }
</style>
