---
import Icon from "../components/Icon";
import Layout from "../layouts/Layout.astro";
import Intro from "../components/Intro.astro";
import Stats from "../components/Stats.astro";
import Closing from "../components/Closing.astro";
import { site } from "../content/site";
---

<Layout title="Meet John Adamou">
  <Intro
    eyebrow="THE EXPERIENCE BEHIND JEA"
    title="Your ambition. An experienced partner."
    description="Independent strategic perspective, international relationships, and a personal commitment to moving your business forward."
  />
  <section class="wrap section about-grid">
    <figure class="portrait">
      <img src="/avatar.png" alt="John Adamou" width="500" height="500" />
      <figcaption>
        John Adamou, MS, MBA<span>PRESIDENT & MANAGING DIRECTOR</span>
      </figcaption>
    </figure>
    <div class="about-copy">
      <p class="eyebrow">MEET JOHN</p>
      <h2>
        A career built
        <br />
        on <em>connection.</em>
      </h2>
      <p>
        John is a seasoned executive with 25+ years of experience in the biotech
        and pharma industries, specializing in strategy and business
        development. He has successfully executed 85 partnerships across
        multiple continents, resulting in over $25 billion in transaction value.
      </p>
      <p>
        His expertise spans the entire BD value chain, including strategy,
        search and evaluation, deal structuring, transaction negotiation, and
        alliance management.
      </p>
      <p>
        Through JEA BizDev Consulting, John advises biotech and biopharma
        companies on identifying, structuring, negotiating, and executing
        partnerships across North America, Europe, and Asia, with a particular
        focus on cross-border transactions.
      </p>
      <div class="actions">
        <a class="button" href="/contact">
          Connect with John
        </a>
        <a
          class="text-link"
          href={site.johnLinkedin}
          target="_blank"
          rel="noreferrer"
        >
          <Icon name="linkedin" size={16} /> LinkedIn
        </a>
      </div>
    </div>
  </section>
  <section class="wrap" style="padding-bottom:70px">
    <Stats />
    <p class="micro" style="margin-top:15px">
      Career experience across healthcare leadership and business development.
    </p>
  </section>
  <section class="tool-spotlight">
    <div class="wrap section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">A BROAD PERSPECTIVE</p>
          <h2>
            Many structures.
            <br />
            One focus: <em>value.</em>
          </h2>
        </div>
        <p>
          From an early conversation to an established alliance, the goal stays
          the same: a partnership that moves your strategy forward.
        </p>
      </div>
      <div class="values-grid">
        <article>
          <h3>Cross-border expertise</h3>
          <p>
            Relationships and transaction experience across North America,
            Europe, and Asia.
          </p>
        </article>
        <article>
          <h3>Diverse deal structures</h3>
          <p>
            Platform technology agreements, collaborations, co-development
            alliances, asset acquisitions, and in- and out-licensing.
          </p>
        </article>
        <article>
          <h3>End-to-end perspective</h3>
          <p>
            Strategic counsel grounded in practical experience throughout the
            partnering process.
          </p>
        </article>
      </div>
    </div>
  </section>
  <Closing />
</Layout>
